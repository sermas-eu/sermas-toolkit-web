{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "./src/**/*.ts",
    "./src/*.ts",
    "./src/**/*.json",
    "toolkit.d.ts",
    "models.ts"
  ],
  "exclude": [
    "node_modules",
  ],
  "compilerOptions": {
    "types": ["vitest/globals"],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "baseUrl": "./src",
    // @sermas/api-client from its sources (sermas-api-client checkout beside this one)
    "paths": {
      "@sermas/api-client": ["../../sermas-api-client/src/index.ts"]
    },
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "allowJs": true,
    "checkJs": true,
    "importsNotUsedAsValues": "remove",
    "preserveValueImports": false,
    "noImplicitOverride": false,
    "useDefineForClassFields": false,
  }
}